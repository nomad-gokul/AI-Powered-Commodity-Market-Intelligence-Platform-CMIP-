# ---- App ----
APP_NAME=CMIP
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ---- Database ----
POSTGRES_USER=cmip
POSTGRES_PASSWORD=cmip_dev_password
POSTGRES_DB=cmip
DATABASE_URL=postgresql+asyncpg://cmip:cmip_dev_password@postgres:5432/cmip

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Rate limiting ----
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Document storage (Phase 2) ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/documents
STORAGE_S3_BUCKET=cmip-documents
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_EXPIRE_SECONDS=3600

# ---- Upload validation (Phase 2) ----
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
UPLOAD_ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tiff"]
# UPLOAD_MAX_DOCUMENTS_PER_USER=

# ---- Document processing (Phase 2) ----
# Path to the tesseract binary if it isn't on PATH (Windows dev machines
# usually need this; the Docker image's tesseract-ocr package is on PATH).
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_MIN_NATIVE_CHARS_PER_PAGE=20
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_BACKOFF_BASE_SECONDS=10

# ---- AI engine & LLM providers (Phase 3.1) ----
# LLM_PROVIDER selects the default provider at runtime - one of
# groq | claude | openai | ollama. Groq is the development default and
# the only provider verified against a live API in this environment.
LLM_PROVIDER=groq
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE_SECONDS=1.0

# Required in production if LLM_PROVIDER=groq (fails fast at startup if
# missing - see Settings._validate_llm_config). Optional in development.
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
